# Base URL of the OpenArm Online API server
OPENARM_ONLINE_API_URL=http://app:8000

# API key sent as the X-API-KEY header to the OpenArm Online API (required)
OPENARM_ONLINE_API_KEY=xxx

# ID of the task to claim jobs for (required)
OPENARM_ONLINE_TASK_ID=1

# Interval in seconds between polls for a new job
#POLL_INTERVAL=3

# Timeout in seconds for the evaluate phase (dora run)
#EVALUATE_TIMEOUT=180

# Timeout in seconds for the reset phase (dora run)
#RESET_TIMEOUT=120

# Directory where the recorder stores recordings
#RECORDER_BASE_DIRECTORY=tmp

# Directory for runner state files such as the not_ready marker
#STATE_DIRECTORY=state

# Dataflow definition file passed to dora run
#DATAFLOW_FILE=dataflow.yaml

# Frames per second used when converting recordings to .rrd
#RRD_FPS=30

# Time window (HH:MM) in which the runner processes jobs; outside of
# it the runner only sleeps. Both must be set to take effect. A window
# crossing midnight (e.g. start=22:00, end=06:00) is also supported.
#ACTIVE_TIME_START=08:00
#ACTIVE_TIME_END=17:00
